{
  "name": "gamevault-server",
  "version": "0.1.0",
  "description": "Self-hosted catalogue for PS4 (PKG) and PS5 (folder) game dumps, with scraped artwork, trailers and a REST API.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "GV_DATA_DIR=./.data node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build:web": "npm --prefix web run build",
    "fixtures": "node test/make-fixtures.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0"
  }
}
